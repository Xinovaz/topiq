// expect: exit 0
// stdout: 2 2 2 8 6
#unit classical

fn show(n: i64) {
    if n >= 10 { show(n / 10); }
    let c = ["0123456789"[(n % 10) as usize]];
    print(&c);
}

struct Config { name: [char], ports: [i64], nested: [[i64]], mode: Mode }
enum Mode { Plain, Listed([i64]) }

fn main() -> i32 {
    let a = Config { name: ['a', 'b'], ports: [80, 443], nested: [[1], [2, 3]], mode: Mode::Listed([7, 8]) };
    let b = clone(&a);
    a.ports.push(8080);
    a.nested[1].push(4);
    a.name.clear();
    match a.mode { Mode::Listed(xs) => {}, Mode::Plain => {} }
    show(b.ports.len() as i64); print(" ");
    show(b.nested[1].len() as i64); print(" ");
    show(b.name.len() as i64); print(" ");
    match b.mode { Mode::Listed(xs) => show(xs[1]), Mode::Plain => print("plain") }
    print(" ");
    let t = clone(&(1, [5, 6]));
    show(t.1[1]);
    print("\n");
    0
}
