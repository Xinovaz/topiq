// expect: exit 0
// stdout: 1/2 * |00> + (1/2 + 1/2 * w(12, 48)) * |10> - 1/2 * |11> / true
// stdout: (1/2 * w(2, 48) + 1/2 * w(6, 48) - 1/2 * w(10, 48)) * |0> + (1/2 * w(2, 48) + 1/2 * w(6, 48) - 1/2 * w(10, 48)) * |1> / true
// stdout: |01> / true / 0 * |00> / false / |0> + |1> / false
// stdout: 1:6 every term of a state names as many qubits / 1:3 this coefficient divides by zero
// stdout: true / 2 2
// stdout: pt / 2 / a fidelity radius is at least zero
// QUON: states read, written back, and checked for being unit vectors.
#unit classical
import quon;
import tcon;

fn line(s: *[char]) {
    match quon::parse(s) {
        Ok(state) => {
            let text = quon::emit(&state);
            print(&text);
            print(" / ");
            match quon::parse(&text) {
                Ok(back) => print(if quon::norm_check(&back) { "true" } else { "false" }),
                Err(e) => print(&e.detail),
            }
        }
        Err(e) => print(&e.detail),
    }
}

fn show(n: u32) {
    if n >= 10 { show(n / 10); }
    let c = ["0123456789"[(n % 10) as usize]];
    print(&c);
}

fn fail(s: *[char]) {
    match quon::parse(s) {
        Ok(_) => print("read"),
        Err(e) => {
            show(e.line);
            print(":");
            show(e.col);
            print(" ");
            print(&e.detail);
        }
    }
}

fn main() -> i32 {
    // The terms come out in order of their kets, `0` before `1`.
    line("1/2 * |00> - 1/2*|11> + (1 + i)/2 * w(1, 12) * w(11, 12) ** |10>");
    print("\n");
    line("isq2 * |0> + isq2 * |1>");
    print("\n");
    line("|0> ** |1>");
    print(" / ");
    line("|00> + |01> - |01> - |00>");
    print(" / ");
    line("1 * |0> + |1>");
    print("\n");
    fail("|0> + |11>");
    print(" / ");
    fail("1/(1 - 1) * |0>");
    print("\n");

    // A state is TCON-serialisable: its terms and exact amplitudes round-trip.
    let s = match quon::parse("isq2 * |01> - isq2 * i * |10>") { Ok(s) => s, Err(_) => { return 1; } };
    let t = tcon::emit(&s);
    match tcon::parse::<quon::State>(&t) {
        Ok(back) => {
            print(if quon::norm_check(&back) { "true" } else { "false" });
            print(" / ");
            show(back.width);
            print(" ");
            show(back.terms.len() as u32);
        }
        Err(e) => print(&e.detail),
    }
    print("\n");

    // The smallest cover holding a state, and the states near it.
    let plus = match quon::parse("isq2 * |0> + isq2 * |1>") { Ok(s) => s, Err(_) => { return 1; } };
    match quon::classify(&plus, frac::from(0)) {
        Ok(quon::Cover::Pt(p)) => print(if quon::norm_check(&p) { "pt" } else { "?" }),
        _ => print("?"),
    }
    print(" / ");
    match quon::classify(&plus, frac::of(1, 100)) {
        Ok(quon::Cover::Span(kets)) => show(kets.len() as u32),
        _ => print("?"),
    }
    print(" / ");
    match quon::classify(&plus, frac::from(-1)) {
        Ok(_) => print("?"),
        Err(e) => print(&e.detail),
    }
    print("\n");
    0
}
