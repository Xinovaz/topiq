// expect: exit 0
// stdout: hello has 2 vowels
// stdout: 12345
// stdout: -42
#unit classical

fn vowels(s: *[char]) -> u64 {
    let n = 0u64;
    for i in 0..s.len() {
        match s[i] {
            'a' => n += 1,
            'e' => n += 1,
            'i' => n += 1,
            'o' => n += 1,
            'u' => n += 1,
            _ => { }
        }
    }
    n
}

// Prints a number one digit at a time, each as a one-character array.
fn print_u64(n: u64) {
    if n >= 10 { print_u64(n / 10); }
    let digit = ["0123456789"[(n % 10) as usize]];
    print(&digit);
}

fn print_i64(n: i64) {
    if n < 0 {
        print("-");
        print_u64((0 - n) as u64);
    } else {
        print_u64(n as u64);
    }
}

fn main() -> i32 {
    let word = "hello";
    print(word);
    print(" has ");
    print_u64(vowels(word));
    print(" vowels\n");
    print_u64(12345);
    print("\n");
    print_i64(-42);
    print("\n");
    if word.len() != 5 || word[1] != 'e' { return 1; }
    0
}
