// expect: exit 0
// stdout: 1 1024 12 1 yes
#unit classical(setup)

// The example of a unit initialiser: a constant needs no code, and an object
// that owns an allocation is given its value before `main` runs.
let TABLE: const [u8; 4] = [1, 2, 3, 5];
let CACHE: [u32];
let ROOM: usize;

fn setup() {
    CACHE = [0u32; 0];
    CACHE.reserve(1024);
    ROOM = 1024;
}

fn next_id() -> u64 {
    persist let counter: u64 = 0;
    counter += 1;
    counter
}

fn show(n: i64) {
    if n >= 10 { show(n / 10); }
    let c = ["0123456789"[(n % 10) as usize]];
    print(&c);
}

// The program's arguments: its own name, and nothing else here.
fn main(argv: *[*[char]]) -> i32 {
    CACHE.push(TABLE[3] as u32);
    show(CACHE.len() as i64);
    print(" ");
    show(ROOM as i64);
    print(" ");
    show(next_id() as i64);
    show(next_id() as i64);
    print(" ");
    show(argv.len() as i64);
    print(if argv[0].len() > 0 { " yes\n" } else { " no\n" });
    0
}
