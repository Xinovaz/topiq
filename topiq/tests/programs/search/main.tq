// expect: exit 0
// stdout: grover 11 11 11
// stdout: amplify 11 11 11
// stdout: rounds 1 3 6 25
// Grover's search for |11>, which one round finds every time, and the
// number of rounds for larger searches.
#unit classical
import circs;
import qpu;

fn pair(r: [bool; 2]) {
    print(" ");
    if r[0] { print("1"); } else { print("0"); }
    if r[1] { print("1"); } else { print("0"); }
}

fn main() -> i32 {
    let dev = qpu::connect("sim://exact").unwrap();
    print("grover");
    for _ in 0..3 { pair(dev.run(circs::search, 0).unwrap()); }
    print("\namplify");
    for _ in 0..3 { pair(dev.run(circs::amplified, 0).unwrap()); }
    let (a, b, c, d) = dev.run(circs::rounds, 0).unwrap();
    print("\nrounds ");
    print(&tcon::emit(&a));
    print(" ");
    print(&tcon::emit(&b));
    print(" ");
    print(&tcon::emit(&c));
    print(" ");
    print(&tcon::emit(&d));
    print("\n");
    0
}
