// expect: exit 25
// `loop` with a value, `continue`, and a `while` whose condition uses `&&`.
#unit classical

fn first_square_over(limit: u32) -> u32 {
    let i = 0u32;
    loop {
        i += 1;
        if i * i > limit {
            break i * i;
        }
    }
}

fn odd_sum(n: u32) -> u32 {
    let total = 0u32;
    for i in 0..n {
        if i % 2 == 0 {
            continue;
        }
        total += i;
    }
    total
}

fn main() -> i32 {
    let k = 0u32;
    while k < 100 && odd_sum(k) < 16 {
        k += 1;
    }
    // odd_sum(8) is 1 + 3 + 5 + 7 = 16, so k stops at 8; 16 + 8 + 1 is 25,
    // which first_square_over(20) also is.
    let expected = first_square_over(20);
    if odd_sum(k) + k + 1 == expected { expected as i32 } else { 0 }
}
