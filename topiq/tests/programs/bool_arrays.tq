// expect: exit 90
// `^`, `&`, `|` and `!` on arrays of bools, element by element, and their
// assignment forms.
#unit classical

// The bits as a number, the first the most significant.
fn bits(b: [bool; 4]) -> i32 {
    let n = 0;
    for i in 0..4 {
        n = n * 2;
        if b[i] { n = n + 1; }
    }
    n
}

fn main() -> i32 {
    let a = [true, true, false, false];   // 12
    let b = [true, false, true, false];   // 10
    let x = a ^ b;                        // 6
    let y = a & b;                        // 8
    let z = a | b;                        // 14
    let n = !a;                           // 3
    let c = a;
    c ^= b;                               // 6
    c |= [false, false, false, true];     // 7
    bits(x) + bits(y) + bits(z) + bits(n) + bits(c) * 7 + 10
}
