//! The `fs` library: files.
//!
//! A file's text is its bytes read as UTF-8, and text is written as UTF-8.
//! A path is as the system takes it: absolute, or relative to the directory
//! the program runs in.
#unit classical

/// Why a file could not be opened, read or written: the `io` library's
/// errors, since a file is read and written as any stream is.
type Error = io::Error;

/// A stream reading the file at `path` from its start.
fn open(path: *const [char]) -> Result<io::Stream, Error> {
    let wide = wide(path)?;
    let handle = __file_open(&wide, false);
    if handle < 0 {
        return Err(io::__error_of(handle));
    }
    Ok(io::__of_file(handle))
}

/// A stream writing the file at `path`, which is made if it was not there
/// and emptied first if it was.
fn create(path: *const [char]) -> Result<io::Stream, Error> {
    let wide = wide(path)?;
    let handle = __file_open(&wide, true);
    if handle < 0 {
        return Err(io::__error_of(handle));
    }
    Ok(io::__of_file(handle))
}

/// The text of the file at `path`. Unlike a stream, which reads a byte that
/// is not UTF-8 as U+FFFD, it is `Error::NotText` when the file holds one.
fn read(path: *const [char]) -> Result<string, Error> {
    let wide = wide(path)?;
    let handle = __file_open(&wide, false);
    if handle < 0 {
        return Err(io::__error_of(handle));
    }
    let size = __file_size(handle);
    if size < 0 {
        __file_close(handle);
        return Err(io::__error_of(size));
    }
    let bytes: [u8] = [];
    for _ in 0..size {
        bytes.push(0);
    }
    let got = __file_read(handle, &bytes);
    __file_close(handle);
    if got < 0 {
        return Err(io::__error_of(got));
    }
    // a file that shrank while it was read holds only what was read
    bytes.truncate(got as usize);
    match str::from_utf8(&bytes) {
        Some(text) => Ok(text),
        None => Err(Error::NotText),
    }
}

/// Makes the file at `path` hold `data`, and nothing else: made if it was
/// not there, emptied first if it was.
fn write(path: *const [char], data: *const [char]) -> Result<(), Error> {
    let file = create(path)?;
    file.write(data)
}

/// `path` in UTF-16, ended with a zero, as the system takes it.
static fn wide(path: *const [char]) -> Result<[u16], Error> {
    let out: [u16] = [];
    for ch in path {
        let c = (*ch) as u32;
        if c == 0 {
            return Err(Error::BadPath);
        }
        if c < 65536 {
            out.push(c as u16);
        } else {
            let v = c - 65536;
            out.push((55296 + v / 1024) as u16);
            out.push((56320 + v % 1024) as u16);
        }
    }
    out.push(0);
    Ok(out)
}
